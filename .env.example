SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-side only. This is used by the account and CRM data APIs; never prefix it with VITE_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Use random values of at least 32 characters. Remove the bootstrap token after the owner is set up.
AUTH_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS
AUTH_BOOTSTRAP_TOKEN=REPLACE_WITH_A_DIFFERENT_ONE_TIME_RANDOM_SECRET

# Required only if you want to retain Google sign-in.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
